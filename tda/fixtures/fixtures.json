{
  "version": 1,
  "tools": [
    {"type": "function", "function": {"name": "get_weather", "description": "Current weather for a city",
      "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name"},
        "unit": {"type": "string", "enum": ["c", "f"]}}, "required": ["city"]}}},
    {"type": "function", "function": {"name": "add", "description": "Add two numbers",
      "parameters": {"type": "object", "properties": {"a": {"type": "number"}, "b": {"type": "number"}}, "required": ["a", "b"]}}}
  ],
  "fixtures": [
    {"id": "F01", "about": "single user turn", "tools": false,
     "messages": [{"role": "user", "content": "Hello there."}]},
    {"id": "F02", "about": "system + user", "tools": false,
     "messages": [{"role": "system", "content": "You answer in one sentence."}, {"role": "user", "content": "What is GGUF?"}]},
    {"id": "F03", "about": "three-turn chat", "tools": false,
     "messages": [{"role": "user", "content": "Pick a colour."}, {"role": "assistant", "content": "Blue."},
                  {"role": "user", "content": "Why?"}]},
    {"id": "F04", "about": "no system message, tools defined", "tools": true,
     "messages": [{"role": "user", "content": "Is it raining in Pune?"}]},
    {"id": "F05", "about": "system + tools, user asks", "tools": true,
     "messages": [{"role": "system", "content": "Use tools when they help."}, {"role": "user", "content": "Weather in Oslo, in c?"}]},
    {"id": "F06", "about": "tool call, tool result, generation prompt", "tools": true,
     "messages": [{"role": "user", "content": "Weather in Oslo?"},
                  {"role": "assistant", "content": "", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": {"city": "Oslo"}}}]},
                  {"role": "tool", "name": "get_weather", "tool_call_id": "call_1", "content": "{\"temp\": 4, \"sky\": \"cloudy\"}"}]},
    {"id": "F07", "about": "two parallel tool calls, two results", "tools": true,
     "messages": [{"role": "user", "content": "Weather in Oslo and Lima?"},
                  {"role": "assistant", "content": "", "tool_calls": [
                    {"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": {"city": "Oslo"}}},
                    {"id": "call_2", "type": "function", "function": {"name": "get_weather", "arguments": {"city": "Lima"}}}]},
                  {"role": "tool", "name": "get_weather", "tool_call_id": "call_1", "content": "{\"temp\": 4}"},
                  {"role": "tool", "name": "get_weather", "tool_call_id": "call_2", "content": "{\"temp\": 19}"}]},
    {"id": "F08", "about": "assistant text and a tool call in one turn", "tools": true,
     "messages": [{"role": "user", "content": "What is 2 + 3?"},
                  {"role": "assistant", "content": "Let me add those.", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "add", "arguments": {"a": 2, "b": 3}}}]},
                  {"role": "tool", "name": "add", "tool_call_id": "call_1", "content": "5"}]},
    {"id": "F09", "about": "tool call id must round-trip; finished exchange then new question", "tools": true,
     "messages": [{"role": "user", "content": "Add 1 and 1."},
                  {"role": "assistant", "content": "", "tool_calls": [{"id": "abc123XYZ", "type": "function", "function": {"name": "add", "arguments": {"a": 1, "b": 1}}}]},
                  {"role": "tool", "name": "add", "tool_call_id": "abc123XYZ", "content": "2"},
                  {"role": "assistant", "content": "1 + 1 = 2."},
                  {"role": "user", "content": "Now add 2 and 2."}]},
    {"id": "F10", "about": "non-ASCII and JSON-special characters", "tools": true,
     "messages": [{"role": "user", "content": "Météo à Zürich? \"quoted\" \\ back\\slash — नमस्ते"},
                  {"role": "assistant", "content": "", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": {"city": "Zürich \"ZH\""}}}]},
                  {"role": "tool", "name": "get_weather", "tool_call_id": "call_1", "content": "{\"temp\": 7, \"note\": \"été\"}"}]},
    {"id": "F11", "about": "reasoning in an earlier assistant turn", "tools": false,
     "messages": [{"role": "user", "content": "Is 7 prime?"},
                  {"role": "assistant", "content": "Yes.", "reasoning_content": "7 has no divisors other than 1 and 7."},
                  {"role": "user", "content": "And 9?"}]},
    {"id": "F12", "about": "template syntax inside user content must stay literal", "tools": false,
     "messages": [{"role": "user", "content": "Explain {{ messages }} and {% if x %} in Jinja."}]}
  ]
}
